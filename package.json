{
	"name": "glhn",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync && wrangler types || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"gen": "wrangler types",
		"deploy": "npm run build && wrangler deploy",
		"deploy:cron": "wrangler deploy -c cron/wrangler.jsonc",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:hoc-vien": "mkdir -p .wrangler && node scripts/hoc-vien-sql.mjs ds_hoc_vien.csv > .wrangler/hoc-vien.sql && wrangler d1 execute DB --local --file .wrangler/hoc-vien.sql",
		"db:hoc-vien:remote": "mkdir -p .wrangler && node scripts/hoc-vien-sql.mjs ds_hoc_vien.csv > .wrangler/hoc-vien.sql && wrangler d1 execute DB --remote --file .wrangler/hoc-vien.sql"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.19.1",
		"daisyui": "^5.7.47",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/merriweather": "^5.3.0"
	}
}

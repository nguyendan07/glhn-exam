{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "glhn-exam-cron",
	"main": "index.ts",
	"compatibility_date": "2026-10-05",
	"triggers": { "crons": ["*/10 * * * *"] },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "glhn-exam",
						"database_id": "7ce38b38-3102-4c80-bca7-00b4e51dce73"
		}
	]
	// Secrets riêng cho worker này: GOOGLE_SA_EMAIL, GOOGLE_SA_PRIVATE_KEY, SHEET_ID
	// npx wrangler secret put GOOGLE_SA_EMAIL -c cron/wrangler.jsonc
}

{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "glhn-exam",
	"compatibility_date": "2026-10-05",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "glhn-thi",
			"database_id": "7ce38b38-3102-4c80-bca7-00b4e51dce73",
			"migrations_dir": "migrations"
		}
	]
	// Secrets (đặt bằng `wrangler secret put`, local đặt trong .dev.vars):
	// GOOGLE_SA_EMAIL, GOOGLE_SA_PRIVATE_KEY, SHEET_ID, ADMIN_TOKEN
}
